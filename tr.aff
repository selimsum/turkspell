# Türkçe Yazım Denetimi Sözlüğü - Chained Flags Architecture
SET UTF-8
FLAG UTF-8
NOSUGGEST Ь
LANG tr
WORDCHARS '

# Break characters (allow breaking at hyphens, en-dashes, and em-dashes)
BREAK 5
BREAK -
BREAK ^-
BREAK -$
BREAK –
BREAK —


