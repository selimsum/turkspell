# Python cache and test artifacts
__pycache__/
*.pyc
.pytest_cache/

# Corpus and wordlist files
*.txt
*.csv
*.json
*.aff.old

# Build inputs — these are sources, not artifacts. The blanket *.json/*.txt
# rules above would otherwise leave a fresh clone unable to build.
!lexicons/zemberek_lexicon.json
!lexicons/custom_abbreviations.json
!lexicons/custom_names.json
!lexicons/authority_pos_completed.json
!lexicons/bilim_sanat_lexicon.json
!lexicons/extra_rep_rules.json
!lexicons/bad_stems.json
!firefox-addon/manifest.json
!firefox-addon-tdk/manifest.json
!tests/golden_verbs_baseline.json
!update.json
!amo-metadata.json
!requirements*.txt

# Generated build outputs (kept out of source control)
turkspell-addon.xpi
turkspell-tdk-addon.xpi
*-unsigned.xpi
tr_test.*

# Firefox extension staging dictionaries & signing artifacts
firefox-addon/dictionaries/
firefox-addon-tdk/dictionaries/
signed_dist/

# Temporary/Experimental build outputs
test_tr.*
tr_v1.*
tr_v2.*
tr_utf8.*
tr_v2_test.*

# Scratch directory exclusions
scratch/

# External dictionaries
external_dictionaries/

# Raw data directory
raw_data/

*.pickle
