# Python cache and test artifacts
__pycache__/
*.pyc
.pytest_cache/

# Corpus and wordlist files
*.txt
*.csv
*.json
*.aff.old

# Build inputs — these are sources, not artifacts. The blanket *.json/*.txt
# rules above would otherwise leave a fresh clone unable to build.
!lexicons/zemberek_lexicon.json
!lexicons/custom_abbreviations.json
!lexicons/custom_names.json
!raw_data/tdk_words.txt
!raw_data/dil_dernegi_words.txt
!firefox-addon/manifest.json
!update.json

# Generated build outputs (kept out of source control)
turkspell-addon.xpi
tr_test.*

# Temporary/Experimental build outputs
test_tr.*
tr_v1.*
tr_v2.*
tr_utf8.*
tr_v2_test.*

# Scratch directory exclusions
scratch/

# External dictionaries
external_dictionaries/

